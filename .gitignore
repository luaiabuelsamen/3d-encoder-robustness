__pycache__/
*.pyc

# Datasets and checkpoints are regenerable; results are not.
# `/runs/` was anchored to the root, so runs_cl/, runs_cl6/ and runs_12k/ were
# tracked and five model.pt files reached the history. The glob covers them.
/data/
runs*/
*.npz
*.npy
*.rrd
external/RVT/

# results/*.json is deliberately NOT ignored: those files are the findings,
# they are a few hundred kB, and without them the figures and the report cannot
# be regenerated or checked by anyone else.
